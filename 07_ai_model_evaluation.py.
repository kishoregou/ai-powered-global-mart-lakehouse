from pyspark.sql import functions as F
from pyspark.ml.evaluation import (
    BinaryClassificationEvaluator,
    MulticlassClassificationEvaluator
)

GOLD_SCHEMA = "gold"

# Read predictions generated by the AI training notebook.
predictions = spark.table(
    f"{GOLD_SCHEMA}.delivery_predictions"
)

# Evaluate classification performance.
auc = BinaryClassificationEvaluator(
    labelCol="label",
    rawPredictionCol="probability",
    metricName="areaUnderROC"
).evaluate(predictions)

f1 = MulticlassClassificationEvaluator(
    labelCol="label",
    predictionCol="prediction",
    metricName="f1"
).evaluate(predictions)

precision = MulticlassClassificationEvaluator(
    labelCol="label",
    predictionCol="prediction",
    metricName="weightedPrecision"
).evaluate(predictions)

recall = MulticlassClassificationEvaluator(
    labelCol="label",
    predictionCol="prediction",
    metricName="weightedRecall"
).evaluate(predictions)

print(f"ROC-AUC: {auc:.4f}")
print(f"Weighted F1: {f1:.4f}")
print(f"Weighted Precision: {precision:.4f}")
print(f"Weighted Recall: {recall:.4f}")

# Confusion matrix.
confusion_matrix = (
    predictions
    .groupBy("label", "prediction")
    .count()
    .orderBy("label", "prediction")
)

display(confusion_matrix)

# Save evaluation metrics.
metrics = spark.createDataFrame(
    [
        ("ROC-AUC", float(auc)),
        ("Weighted F1", float(f1)),
        ("Weighted Precision", float(precision)),
        ("Weighted Recall", float(recall)),
    ],
    ["metric_name", "metric_value"]
).withColumn("evaluated_at", F.current_timestamp())

(
    metrics.write
    .format("delta")
    .mode("overwrite")
    .option("overwriteSchema", "true")
    .saveAsTable(f"{GOLD_SCHEMA}.ai_model_metrics")
)

display(metrics)

print("AI evaluation report saved.")
